# .env.example - Environment variable template for URP (Universal Robotic Programmer)
#
# To use this file, copy it to ~/.urp-go/.env and fill in your API keys and desired model configurations.
# Variables defined in your shell session will override those in ~/.urp-go/.env.

# --- LLM API Keys ---
# Required for LLM providers. At least one of ANTHROPIC_API_KEY or OPENAI_API_KEY must be set.

# Anthropic API Key: For accessing Claude models.
# ANTHROPIC_API_KEY="sk-ant-..."

# OpenAI-compatible API Key: Used for OpenAI GPT models, and also for proxies like OpenRouter
# that provide access to various models (including Gemini/GLM, Qwen, etc.) via an OpenAI-like interface.
# OPENAI_API_KEY="sk-or-v1-..."

# DeepSeek API Key: For accessing DeepSeek models.
# DEEPSEEK_API_KEY="sk-deepseek-..."

# Google API Key: For accessing Gemini models.
# GOOGLE_API_KEY="AIza..."

# Hugging Face Token: Required for the Text Embeddings Inference (TEI) service to download models.
# Replaces HF_API_TOKEN which is deprecated.
HF_TOKEN="hf_YOUR_HUGGING_FACE_TOKEN"

# GitHub Token: May be required for TEI if models or dependencies are fetched via GitHub (e.g., git cloning).
# Also used by URP for GitHub-related operations (e.g., PRs).
GITHUB_TOKEN="ghp_YOUR_GITHUB_TOKEN"


# --- LLM Provider Base URLs ---
# Override default API endpoints if using self-hosted, custom proxy, or specific regional services.

# Anthropic Base URL: Custom endpoint for Claude models.
# ANTHROPIC_BASE_URL="https://api.anthropic.com/v1"

# OpenAI-compatible Base URL: Custom endpoint for OpenAI-like APIs (e.g., OpenRouter).
# OPENAI_BASE_URL="https://openrouter.ai/api/v1"

# DeepSeek Base URL: Custom endpoint for DeepSeek models.
# DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"

# Google Base URL: Custom endpoint for Gemini models.
# GOOGLE_BASE_URL="https://generativelanguage.googleapis.com/v1beta"


# --- URP Master/Brain Model Configuration ---
# The "Brain" or "Architect" LLM - responsible for high-level reasoning, planning, and task decomposition.
# Requires strong reasoning capabilities.

# Model ID to use for URP Master Agent
URP_MASTER_MODEL_ID="anthropic/claude-sonnet-4-5-20250929"

# Provider URL for Master Model (optional - overrides default provider base URL)
# URP_MASTER_MODEL_URL="https://my-custom-provider.com/v1"

# Master Model API Key (optional - overrides default API key)
# URP_MASTER_MODEL_API_KEY="sk-custom-key"


# --- URP Gate/Filter Model Configuration ---
# The "Gatekeeper" or "Noise Filter" LLM - filters irrelevant information to present concise context.
# Should be fast and efficient.

# Model ID to use for URP Gate Model
URP_GATE_MODEL_ID="gpt-4o-mini"

# Provider URL for Gate Model (optional - overrides default provider base URL)
# URP_GATE_MODEL_URL="https://my-custom-provider.com/v1"

# Gate Model API Key (optional - overrides default API key)
# URP_GATE_MODEL_API_KEY="sk-custom-key"


# --- URP Worker Model Configuration ---
# Model used for execution tasks in worker containers.
# Can be different from Master to optimize for task execution.

# Model ID to use for URP Worker Agent
URP_WORKER_MODEL_ID="deepseek-chat"

# Provider URL for Worker Model (optional - overrides default provider base URL)
# URP_WORKER_MODEL_URL="https://my-custom-provider.com/v1"

# Worker Model API Key (optional - overrides default API key)
# URP_WORKER_MODEL_API_KEY="sk-custom-key"


# --- URP Fallback Model Configuration ---
# Model to use if primary models fail to initialize.
# Provides resilience in case of model unavailability.

# Fallback model ID (for primary model failures)
URP_FALLBACK_MODEL_ID="gpt-4o-mini"


# --- Model Configuration by Function ---
# More specific model assignments for different functions

# Model for coding tasks
URP_CODING_MODEL_ID="deepseek-coder"

# Model for reasoning tasks
URP_REASONING_MODEL_ID="o1"

# Model for quick responses and filtering
URP_FAST_MODEL_ID="gpt-4o-mini"

# Model for vision tasks (if needed)
URP_VISION_MODEL_ID="gpt-4o"

# Model for long context tasks
URP_LONG_CONTEXT_MODEL_ID="claude-opus-4-20250514"


# --- Advanced Model Configuration ---
# For advanced users who need specific provider configurations

# Unified/OpenRouter Base URL (for proxy providers)
# UNIFIED_BASE_URL="https://openrouter.ai/api/v1"

# Unified/OpenRouter API Key (for proxy providers)
# UNIFIED_API_KEY="sk-or-v1-..."


# --- Other Configuration ---

# Default URI for the Neo4j graph database.
# NEO4J_URI="bolt://localhost:7687"

# Neo4j username and password
# NEO4J_USER="neo4j"
# NEO4J_PASSWORD="password"

# --- Advanced URP Settings ---

# URP_PROJECT="my_project"
# URP_SESSION_ID="my_session_id"
# URP_HOST_PATH="/path/to/your/project"
# URP_HOST_HOME="/path/to/your/home"
# URP_CONTAINER_MODE="1"
# URP_MASTER="1"
# URP_WORKER_ID="worker-1"
# URP_THINKING="10" # Thinking budget in tokens or turns
